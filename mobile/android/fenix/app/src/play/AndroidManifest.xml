<!-- Applied to Google Play release builds only (AKHI_PLAY_STORE=1). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove" />
    <uses-permission android:name="com.adjust.preinstall.READ_PERMISSION" tools:node="remove" />
    <uses-permission-sdk-23 android:name="android.permission.REQUEST_INSTALL_PACKAGES" tools:node="remove" />

    <application>
        <receiver android:name="com.adjust.sdk.AdjustPreinstallReferrerReceiver" tools:node="remove" />
        <provider android:name="com.adjust.sdk.SystemLifecycleContentProvider" tools:node="remove" />
    </application>
</manifest>

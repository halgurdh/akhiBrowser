<!-- Applied to Google Play release builds only (AKHI_PLAY_STORE=1). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove" />
    <uses-permission android:name="com.adjust.preinstall.READ_PERMISSION" tools:node="remove" />
    <uses-permission-sdk-23 android:name="android.permission.REQUEST_INSTALL_PACKAGES" tools:node="remove" />

    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:node="remove" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" tools:node="remove" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" tools:node="remove" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" tools:node="remove" />

    <application>
        <service android:name="org.mozilla.fenix.components.AkhiAppBlockService" tools:node="remove" />
        <activity android:name="org.mozilla.fenix.components.AkhiAppBlockActivity" tools:node="remove" />
        <receiver android:name="org.mozilla.fenix.components.AkhiAppBlockBoot" tools:node="remove" />
        <receiver android:name="com.adjust.sdk.AdjustPreinstallReferrerReceiver" tools:node="remove" />
        <provider android:name="com.adjust.sdk.SystemLifecycleContentProvider" tools:node="remove" />
    </application>
</manifest>
